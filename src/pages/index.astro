---
import Layout from '../layouts/Layout.astro';
import Glyph from '../components/Glyph.astro';
import Chrome from '../components/Chrome.astro';
import Hero from '../components/Hero.astro';
import Thesis from '../components/Thesis.astro';
import Work from '../components/Work.astro';
import Context from '../components/Context.astro';
import Projects from '../components/Projects.astro';
import Research from '../components/Research.astro';
import Atlas from '../components/Atlas.astro';
import Principles from '../components/Principles.astro';
import Join from '../components/Join.astro';
import Footer from '../components/Footer.astro';
---
<Layout>
