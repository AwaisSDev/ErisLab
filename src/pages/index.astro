  <main id="top">
    <Hero />
    <Thesis />
    <Work />
    <Context />
    <Projects />
    <Research />
    <Atlas />
    <Principles />
    <Join />
  </main>
  <Footer />
</Layout>

<script>
  import '../scripts/main.js';
</script>
