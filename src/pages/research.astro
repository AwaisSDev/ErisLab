---
import LabLayout from '../layouts/LabLayout.astro';
import Glyph from '../components/Glyph.astro';
import {
  site, mission, philosophy, work, projects, direction, standing,
  research, principles, collaborate, faq,
} from '../data/content.js';

const areaKeys = ['privacy', 'context', 'memory', 'agents', 'efficient'];
const areaLabel = Object.fromEntries(research.areas.map(a => [a.key, a.label]));
const areaFull = Object.fromEntries(areaKeys.map((k, i) => [k, work[i].tag]));
const questions = [...research.featured.map(f => ({ ...f, featured: true })), ...research.rows];
const feature = research.featured[0];
const pad = (n) => String(n).padStart(2, '0');
const mail = (subject) => `mailto:${site.email}?subject=${encodeURIComponent(subject)}`;

// Each focus area shows three cards: its open questions first, then its research directions.
const kinds = ['orbit', 'contour', 'flow', 'halftone', 'mesh', 'attention', 'orb'];
const areaCards = areaKeys.map((key, ai) => {
  const qs = questions.filter(q => q.type === key).map(q => ({ title: q.title, meta: 'Open question', art: q.art === 'tokens' ? 'mesh' : q.art, seed: q.seed }));
  const used = new Set(qs.map(q => q.art));
  const free = kinds.filter(k => !used.has(k));
  const pts = work[ai].points.map((p, j) => ({ title: p, meta: 'Research direction', art: free[(ai * 2 + j) % free.length], seed: 50 + ai * 10 + j }));
  return [...qs, ...pts].slice(0, 3);
});

// hero mosaic tiles: [art, seed, gridArea, parallax]
const tiles = [
  ['flow', 26, '1 / 1 / 5 / 2', -0.6],
  ['halftone', 8, '1 / 2 / 3 / 4', 0.35],
  ['orbit', 1, '3 / 2 / 5 / 3', -0.3],
  ['contour', 35, '3 / 3 / 5 / 4', 0.5],
  ['planet', 44, '1 / 4 / 5 / 5', -0.45],
  ['attention', 12, '1 / 5 / 3 / 7', 0.4],
  ['mesh', 11, '3 / 5 / 5 / 6', -0.25],
  ['orbit', 13, '3 / 6 / 5 / 7', 0.55],
];
---
<LabLayout title={`Research · ${site.name}`}>
  <Glyph />

  <header class="nav" data-nav>
    <div class="nav__in">
      <a class="brand" href="/" aria-label={`${site.name} home`}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#glyph" /></svg>
        <span>{site.name}</span>
      </a>
      <nav class="nav__links" aria-label="Sections">
        <a href="#focus">Research</a>
        <a href="#projects">Projects</a>
        <a href="#index">Open questions</a>
        <a href="#principles">Principles</a>
        <a href="#collaborate">Collaborate</a>
      </nav>
      <div class="nav__cta">
        <a class="pill pill--soft" href="/">Home</a>
        <a class="pill pill--ink" href={`mailto:${site.email}`}>Get in touch <span aria-hidden="true">↗</span></a>
        <button class="burger" type="button" aria-label="Open menu" aria-expanded="false" data-menu-btn><i></i><i></i></button>
      </div>
    </div>
    <div class="drawer" data-drawer hidden>
      <a href="#focus">Research</a><a href="#projects">Projects</a><a href="#index">Open questions</a>
      <a href="#principles">Principles</a><a href="#collaborate">Collaborate</a><a href="/">Home</a>
      <a class="pill pill--ink pill--lg" href={`mailto:${site.email}`}>Get in touch <span aria-hidden="true">↗</span></a>
    </div>
  </header>

  <main>
    <!-- hero -->
    <section class="hero wrap">
      <span class="label" data-rise>Research</span>
      <h1 class="hero__title" data-rise>AI that understands people, <span class="tone">not just prompts</span></h1>
      <p class="hero__lede" data-rise>{mission}</p>
      <div class="hero__cta" data-rise>
        <a class="pill pill--soft pill--md" href="#index">View open questions</a>
        <a class="textlink" href="#principles">Read our principles <span aria-hidden="true">›</span></a>
      </div>
      <div class="mosaic" data-mosaic data-rise>
        {tiles.map(([art, seed, area, k]) => (
          <div class="tile" style={`grid-area:${area}`}><canvas data-art={art} data-seed={seed} data-par={k} aria-hidden="true"></canvas></div>
        ))}
      </div>
    </section>

    <!-- focus statement -->
    <section class="focus wrap" id="focus">
      <span class="label" data-rise>Focus areas</span>
      <p class="focus__text" data-rise>{philosophy} We study this through five areas of research.</p>
    </section>

    <!-- one section per area, three cards each -->
    {work.map((w, ai) => (
      <section class="area wrap" id={`area-${areaKeys[ai]}`}>
        <h2 class="area__title" data-rise>{w.tag}</h2>
        <p class="area__body" data-rise>{w.body}</p>
        <div class="cards">
          {areaCards[ai].map(c => (
            <a class="card" href={mail(c.title)} data-rise>
              <div class="card__media"><canvas data-art={c.art} data-seed={c.seed} aria-hidden="true"></canvas></div>
              <h3 class="card__title">{c.title}</h3>
              <p class="card__meta"><b>{areaLabel[areaKeys[ai]]}</b><span>{c.meta}</span></p>
            </a>
          ))}
        </div>
      </section>
    ))}

    <!-- featured question, article layout -->
    <section class="article wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="#index">Research</a><span>/</span><span aria-current="page">Featured question</span></nav>
      <h2 class="article__title" data-rise>{feature.title}</h2>
      <a class="pill pill--ink pill--md" href={mail('Research collaboration')} data-rise>Discuss this question</a>
      <div class="article__media" data-rise>
        <canvas data-art={feature.art} data-seed={feature.seed} aria-hidden="true"></canvas>
      </div>
      <div class="prose" data-rise>
        <p>{work[0].body} {mission}</p>
        <p>{standing[0][1]} {standing[1][1]}</p>
      </div>
    </section>

    <!-- projects -->
    <section class="area wrap" id="projects">
      <h2 class="area__title" data-rise>Projects</h2>
      <p class="area__body" data-rise>Research and development work across context, routing, local agents and frontier reasoning. None of these are launched products.</p>
      <div class="cards cards--2">
        {projects.map(p => (
          <a class="card" href={mail(p.name)} data-rise>
            <div class="card__media card__media--wide">
              <canvas data-art={p.art} data-seed={p.seed} aria-hidden="true"></canvas>
              <span class="card__overlay">{p.name}</span>
            </div>
            <h3 class="card__title">{p.body}</h3>
            <p class="card__meta"><b>{p.name}</b><span>{p.kind}</span></p>
          </a>
        ))}
      </div>
    </section>

    <!-- index -->
    <section class="index wrap" id="index">
      <h2 class="index__title">Open questions</h2>
      <div class="toolbar">
        <div class="tabs" data-filters>
          <button class="is-active" data-filter="all" type="button">All</button>
          {research.areas.map(a => <button data-filter={a.key} type="button">{a.label}</button>)}
        </div>
        <div class="views" data-views>
          <button class="is-active" data-view="list" type="button" aria-label="List view">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 4h12M2 8h12M2 12h12"/></svg>
          </button>
          <button data-view="grid" type="button" aria-label="Grid view">
            <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="2" y="2" width="5" height="5"/><rect x="9" y="2" width="5" height="5"/><rect x="2" y="9" width="5" height="5"/><rect x="9" y="9" width="5" height="5"/></svg>
          </button>
        </div>
      </div>
      <ol class="qlist" data-qlist data-view="list">
        {questions.map(q => (
          <li class="q" data-type={q.type}>
            <a href={mail(q.title)}>
              <div class="q__side">
                <span class="q__area">{areaLabel[q.type]}</span>
                <span class="muted">{q.featured ? 'Featured question' : 'Open question'}</span>
              </div>
              <div class="q__cover"><canvas data-art={q.art === 'tokens' ? 'mesh' : q.art} data-seed={q.seed} aria-hidden="true"></canvas></div>
              <div class="q__main">
                <h3>{q.title}</h3>
                <p class="muted">{areaFull[q.type]}</p>
              </div>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <!-- direction + limitations, article prose -->
    <section class="article article--text wrap">
      <div class="prose">
        <h2>Technical direction</h2>
        <p>The work above breaks down into a set of concrete research directions:</p>
        <ol class="prose__list">
          {direction.map(d => <li>{d}</li>)}
        </ol>
        <h2>Where we stand</h2>
        {standing.map(([t, b]) => <p><b>{t}</b> {b}</p>)}
      </div>
    </section>

    <!-- principles, row list -->
    <section class="rows-sec wrap" id="principles">
      <h2 class="area__title" data-rise>Principles</h2>
      <p class="area__body" data-rise>What we hold ourselves to while doing this research.</p>
      <ul class="rows">
        {principles.map((p, i) => (
          <li data-rise><span class="rows__num">{pad(i + 1)}</span><b>{p.title}</b><span class="muted">{p.body}</span></li>
        ))}
      </ul>
    </section>

    <!-- collaborate, roles-style rows -->
    <section class="rows-sec wrap" id="collaborate">
      <h2 class="area__title" data-rise>Collaborate</h2>
      <p class="area__body" data-rise>We’re a small, independent lab. If these questions matter to you, we’d like to hear from you.</p>
      <a class="pill pill--soft pill--md" href={`mailto:${site.email}`} data-rise>{site.email}</a>
      <ul class="rows rows--links">
        {collaborate.map(([t, s, subj]) => (
          <li data-rise><b>{t}</b><span class="muted">{s}</span><a href={mail(subj)}>Email us <span aria-hidden="true">↗</span></a></li>
        ))}
      </ul>
      <div class="faq">
        {faq.map(([q, a]) => (
          <details><summary>{q}<i aria-hidden="true"></i></summary><p class="muted">{a}</p></details>
        ))}
      </div>
    </section>

    <!-- explore panel -->
    <section class="wrap">
      <div class="explore" data-rise>
        <h2>Explore all open questions</h2>
        <a class="pill pill--soft pill--md" href="#index">View open questions</a>
      </div>
    </section>
  </main>

  <footer class="foot wrap">
    <div class="foot__cols">
      <div><h4>Research</h4><a href="#index">Open questions</a><a href="#focus">Focus areas</a><a href="#principles">Principles</a></div>
      <div><h4>Focus areas</h4>{work.map((w, i) => <a href={`#area-${areaKeys[i]}`}>{w.tag}</a>)}</div>
      <div><h4>Projects</h4>{projects.map(p => <a href="#projects">{p.name}</a>)}</div>
      <div><h4>Lab</h4><a href="/">Home</a><a href="#collaborate">Collaborate</a><a href={`mailto:${site.email}`}>Contact</a></div>
    </div>
    <div class="foot__bottom">
      <a class="brand brand--sm" href="/"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#glyph" /></svg><span>{site.name}</span></a>
      <span>© {new Date().getFullYear()} {site.name}. Research reported as research; visuals are generated from synthetic data.</span>
    </div>
  </footer>
</LabLayout>

<script>
  import '../scripts/lab.js';
</script>
