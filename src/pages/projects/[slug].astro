---
import LabLayout from '../../layouts/LabLayout.astro';
import Glyph from '../../components/Glyph.astro';
import LabNav from '../../components/lab/LabNav.astro';
import LabFooter from '../../components/lab/LabFooter.astro';
import CtaPanel from '../../components/lab/CtaPanel.astro';
import Sections from '../../components/lab/Sections.astro';
import { site } from '../../data/content.js';
import { projectList, questions, areaByKey, mail } from '../../data/lab.js';

export function getStaticPaths() {
  return projectList.map(p => ({ params: { slug: p.slug } }));
}
const p = projectList.find(x => x.slug === Astro.params.slug);
const related = questions.filter(q => p.areas.includes(q.type)).slice(0, 3);
const others = projectList.filter(x => x !== p);
---
<LabLayout title={`${p.name}: ${p.kind} · ${site.name}`} description={p.body}>
  <Glyph />
  <LabNav current="projects" />
  <main>
    <article class="article article--page wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/#projects">Projects</a><span>/</span><span aria-current="page">{p.name}</span></nav>
      <h1 class="article__title article__title--xl" data-rise>{p.name}</h1>
      <p class="article__kicker" data-rise>{p.kind}</p>
      <div class="article__actions" data-rise>
        <a class="pill pill--ink pill--md" href={mail(p.name)}>Ask about {p.name}</a>
      </div>
      <div class="article__media" data-rise><canvas data-art={p.art} data-seed={p.seed} aria-hidden="true"></canvas></div>
      <div class="prose">
        <Sections sections={p.sections} />
        <h2>Related focus areas</h2>
        <div class="chips chips--left">
          {p.areas.map(k => <a class="pill pill--soft" href={areaByKey[k].href}>{areaByKey[k].tag}</a>)}
        </div>
      </div>
    </article>

    {related.length > 0 && (
      <section class="area wrap">
        <h2 class="area__title" data-rise>Related open questions</h2>
        <div class="cards">
          {related.map(r => (
            <a class="card" href={r.href} data-rise>
              <div class="card__media"><canvas data-art={r.art} data-seed={r.seed} aria-hidden="true"></canvas></div>
              <h3 class="card__title">{r.title}</h3>
              <p class="card__meta"><b>{r.area.label}</b><span>Open question</span></p>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="area wrap">
      <h2 class="area__title" data-rise>Other projects</h2>
      <div class="cards">
        {others.map(o => (
          <a class="card" href={o.href} data-rise>
            <div class="card__media card__media--wide">
              <canvas data-art={o.art} data-seed={o.seed} aria-hidden="true"></canvas>
              <span class="card__overlay card__overlay--sm">{o.name}</span>
            </div>
            <h3 class="card__title">{o.body}</h3>
            <p class="card__meta"><b>{o.name}</b><span>{o.kind}</span></p>
          </a>
        ))}
      </div>
    </section>

    <CtaPanel />
  </main>
  <LabFooter />
</LabLayout>

<script>
  import '../../scripts/lab.js';
</script>
