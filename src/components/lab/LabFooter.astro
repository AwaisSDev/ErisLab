---
import { site, philosophy } from '../../data/content.js';
import { areas, projectList } from '../../data/lab.js';
const year = new Date().getFullYear();
---
<footer class="foot">
  <div class="wrap">
    <div class="foot__top">
      <div class="foot__intro">
        <a class="brand" href="/"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#glyph" /></svg><span>{site.name}</span></a>
        <p>{philosophy}</p>
        <div class="foot__actions">
          <a class="pill pill--ink" href={`mailto:${site.email}`} target="_blank" rel="noopener">Get in touch <span aria-hidden="true">↗</span></a>
          <a class="textlink" href={`mailto:${site.email}`} target="_blank" rel="noopener">{site.email}</a>
        </div>
      </div>
      <nav class="foot__cols" aria-label="Footer">
        <div>
          <h4>Research</h4>
          <a href="/questions">Open questions</a>
          <a href="/#focus">Focus areas</a>
          <a href="/#direction">Technical direction</a>
          <a href="/#principles">Principles</a>
        </div>
        <div>
          <h4>Focus areas</h4>
          {areas.map(a => <a href={a.href}>{a.tag}</a>)}
        </div>
        <div>
          <h4>Projects</h4>
          {projectList.map(p => <a href={p.href}>{p.name}</a>)}
        </div>
        <div>
          <h4>Company</h4>
          <a href="/founder">Founder</a>
          <a href="/careers">Careers</a>
          <a href="/#collaborate">Collaborate</a>
          <a href="/#faq">FAQ</a>
          <a href={`mailto:${site.email}`} target="_blank" rel="noopener">Contact</a>
          <a href="/classic">Classic site</a>
        </div>
      </nav>
    </div>
    <div class="foot__bottom">
      <div class="foot__legal">
        <span>© {year} {site.legalName}. All rights reserved.</span>
        <span>Research reported as research. Visuals are generated from synthetic data.</span>
      </div>
      <nav class="foot__legal-links" aria-label="Legal">
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Use</a>
        <a href="/trademarks">Trademarks</a>
        <button class="foot__top-btn" type="button" data-to-top>Back to top <span aria-hidden="true">↑</span></button>
      </nav>
    </div>
  </div>
  <div class="foot__mark" aria-hidden="true">{site.name}</div>
</footer>
