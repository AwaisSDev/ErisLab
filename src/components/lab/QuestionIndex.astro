---
import { research } from '../../data/content.js';
import { questions, areaLabel } from '../../data/lab.js';
interface Props { controls?: boolean; limit?: number; filter?: string }
const { controls = true, limit, filter } = Astro.props;
const list = questions.filter(q => !filter || q.type === filter).slice(0, limit ?? questions.length);
---
{controls && (
  <div class="toolbar">
    <div class="tabs" data-filters>
      <button class="is-active" data-filter="all" type="button">All</button>
      {research.areas.map(a => <button data-filter={a.key} type="button">{a.label}</button>)}
    </div>
    <div class="views" data-views>
      <button class="is-active" data-view="list" type="button" aria-label="List view">
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 4h12M2 8h12M2 12h12"/></svg>
      </button>
      <button data-view="grid" type="button" aria-label="Grid view">
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><rect x="2" y="2" width="5" height="5"/><rect x="9" y="2" width="5" height="5"/><rect x="2" y="9" width="5" height="5"/><rect x="9" y="9" width="5" height="5"/></svg>
      </button>
    </div>
  </div>
)}
<ol class:list={['qlist', { 'qlist--plain': !controls }]} data-qlist data-view="list">
  {list.map(q => (
    <li class="q" data-type={q.type}>
      <a href={q.href}>
        <div class="q__side">
          <span class="q__area">{areaLabel[q.type]}</span>
          <span class="muted">{q.featured ? 'Featured question' : 'Open question'}</span>
        </div>
        <div class="q__cover"><canvas data-art={q.art} data-seed={q.seed} aria-hidden="true"></canvas></div>
        <div class="q__main">
          <h3>{q.title}</h3>
          <p class="muted">{q.summary}</p>
        </div>
      </a>
    </li>
  ))}
</ol>
