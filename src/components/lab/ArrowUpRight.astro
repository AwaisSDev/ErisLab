---
// Thin up-right arrow drawn as SVG, so iOS never swaps it for an emoji (as it does with "↗").
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<svg class:list={['icon-arrow', cls]} width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4.5 11.5 11.5 4.5M5.75 4.5h5.75v5.75" /></svg>
