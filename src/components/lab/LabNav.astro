---
import ArrowUpRight from './ArrowUpRight.astro';
import { site } from '../../data/content.js';
interface Props { current?: string }
const { current = '' } = Astro.props;
const links = [
  ['research', 'Research', '/#focus'],
  ['projects', 'Projects', '/#projects'],
  ['questions', 'Open questions', '/questions'],
  ['careers', 'Careers', '/careers'],
];
---
<header class="nav" data-nav>
  <div class="nav__in">
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><use href="#glyph" /></svg>
      <span>{site.name}</span>
    </a>
    <nav class="nav__links" aria-label="Main">
      {links.map(([k, label, href]) => <a href={href} aria-current={k === current ? 'page' : undefined}>{label}</a>)}
    </nav>
    <div class="nav__cta">
      <a class="pill pill--ink" href={`mailto:${site.email}`} target="_blank" rel="noopener">Get in touch <ArrowUpRight /></a>
      <button class="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="site-menu" data-menu-btn><i></i><i></i></button>
    </div>
  </div>
</header>
<!-- Kept outside <header>: the header's backdrop-filter would otherwise become the drawer's
     containing block, squashing the fixed drawer to the header's 68px height (the iOS glitch). -->
<div class="drawer" id="site-menu" data-drawer hidden>
  <a href="/">Home</a>
  {links.map(([, label, href]) => <a href={href}>{label}</a>)}
  <a class="pill pill--ink pill--lg" href={`mailto:${site.email}`} target="_blank" rel="noopener">Get in touch <ArrowUpRight /></a>
</div>
