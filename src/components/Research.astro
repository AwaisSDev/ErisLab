---
import { research } from '../data/content.js';
---
<section class="solid research" id="research" data-chapter="research" data-chrome="dark" data-frame="off">
  <div class="wrap">
    <div class="research__head">
      <h2 class="research__title" data-split>Research</h2>
      <div class="filters" role="tablist" data-research-filters>
        <button class="is-active" data-filter="all">All</button>
        <button data-filter="publication">Publications</button>
        <button data-filter="release">Releases</button>
        <button data-filter="safety">Privacy &amp; Safety</button>
      </div>
    </div>

    <div class="featured">
      {research.featured.map((f) => (
        <a class="feat" href="#" data-reveal data-type={f.type}>
          <div class="feat__cover"><canvas data-art={f.art} data-seed={f.seed}></canvas></div>
          <div class="feat__meta">
            <span class="mono">{f.type === 'release' ? 'Release' : 'Publication'} · {f.date}</span>
            <h3>{f.title}</h3>
          </div>
        </a>
      ))}
    </div>

    <ul class="rows">
      {research.rows.map((r) => (
        <li class="row" data-type={r.type} data-art={r.art} data-seed={r.seed}>
          <a href="#"><time class="mono">{r.date}</time><span class="row__t">{r.title}</span><span class="row__c mono">{r.cat}</span><b>→</b></a>
        </li>
      ))}
    </ul>
    <a class="more mono" href="#">View all research <b>→</b></a>
  </div>
  <div class="peek" aria-hidden="true" data-peek><canvas width="320" height="220"></canvas></div>
</section>
