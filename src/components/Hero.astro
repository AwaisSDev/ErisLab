---
import { mission } from '../data/content.js';
---
<section class="cine hero" data-scene="0" data-chapter="thesis" data-chrome="light" data-frame="on">
  <div class="sticky">
    <div class="hero__copy" data-hero>
      <h1 class="display" data-split>AI that understands your life.</h1>
      <p class="sub serif" data-split>Without compromising your privacy.</p>
      <a class="btn btn--ink hero__btn" href="#work" data-scrollto="#work"><span>Explore the research</span><b class="btn__arrow">→</b></a>
    </div>
    <div class="hero__below" data-hero>
      <span class="tag">Our mission</span>
      <p>{mission}</p>
    </div>
    <div class="hero__scroll mono" data-hero><i></i>Scroll</div>
  </div>
</section>
