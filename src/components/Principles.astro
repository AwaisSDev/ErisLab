---
import { principles } from '../data/content.js';
const arts = {
  shield: '<path d="M60 12 L88 22 V42 C88 58 76 68 60 72 C44 68 32 58 32 42 V22 Z"/><circle class="acc" cx="60" cy="42" r="6"/>',
  device: '<rect x="40" y="10" width="40" height="62" rx="7"/><path d="M54 64h12"/><circle class="acc" cx="60" cy="36" r="6"/><path d="M14 36h18M88 36h18" stroke-dasharray="2 4"/>',
  nudge: '<circle cx="46" cy="40" r="22"/><circle cx="84" cy="40" r="10"/><path class="acc" d="M68 40h6"/>',
  fade: '<circle cx="30" cy="40" r="10"/><circle cx="56" cy="40" r="10" opacity=".55"/><circle cx="82" cy="40" r="10" opacity=".25"/><circle class="acc" cx="30" cy="40" r="3"/>',
};
---
<section class="solid principles" id="principles" data-chapter="principles" data-chrome="dark" data-frame="off">
  <div class="wrap principles__wrap">
    <aside class="principles__aside">
      <div class="sticky-ish">
        <span class="mono">What we believe</span>
        <p class="principles__note">Eris Lab is an independent research company. These are the commitments we hold ourselves to — and the ones we expect you to hold us to.</p>
      </div>
    </aside>
    <div class="principles__main">
      <p class="principles__intro serif" data-split>AI that knows enough to help, remembers enough to understand, and respects your privacy enough to be trusted. Not just smarter AI — AI that fits into human life.</p>
      <div class="plist">
        {principles.map((p, i) => (
          <article class="p" data-reveal>
            <svg class="p__art" viewBox="0 0 120 80" aria-hidden="true" set:html={arts[p.art]} />
            <span class="mono">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="serif">{p.title}</h3>
            <p>{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
