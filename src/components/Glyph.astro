---
// Shared SVG symbol: the dwarf planet Eris, its ring of orbit, and its moon.
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <mask id="glyph-back" maskUnits="userSpaceOnUse" x="0" y="0" width="24" height="24">
      <rect width="24" height="24" fill="#fff" />
      <circle cx="12" cy="12" r="6.6" fill="#000" />
    </mask>
  </defs>
  <symbol id="glyph" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
      <circle cx="12" cy="12" r="5.2" />
      <g transform="rotate(-18 12 12)">
        <path d="M1.6 12 A10.4 3.3 0 0 1 22.4 12" mask="url(#glyph-back)" />
        <path d="M1.6 12 A10.4 3.3 0 0 0 22.4 12" />
      </g>
    </g>
    <circle cx="19.6" cy="4.6" r="1.25" fill="currentColor" />
  </symbol>
</svg>
